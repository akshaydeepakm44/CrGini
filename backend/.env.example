PORT=5001
NODE_ENV=production

# Isolated Database
# NOTE: If your password contains special characters like #, $, quotes, or spaces, wrap it in double quotes!
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dizigini_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_SSL=false

# Isolated Auth & Origins
JWT_SECRET=dizigini_secure_jwt_secret_key_2026
CLIENT_URL=http://dizigini.com,https://dizigini.com,http://www.dizigini.com,https://www.dizigini.com,http://localhost:5173,http://localhost:5174

# DiziGini Branding
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=team@dizigini.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="DiziGini <team@dizigini.com>"
PORTAL_BASE_URL=http://dizigini.com

# Isolated Storage
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=dizigini-assets
