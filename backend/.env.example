PORT=5000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=creativegini
POSTGRES_USER=creativegini_app
POSTGRES_PASSWORD=your_postgres_password_here

JWT_SECRET=your_jwt_secret_key_here

CLIENT_URL=http://localhost:5173,http://localhost:5174

# Email / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=team@creativegini.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM="CreativeGini <team@creativegini.com>"
PORTAL_BASE_URL=http://localhost:5174

# MinIO Object Storage Configuration
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=creativegini-assets
