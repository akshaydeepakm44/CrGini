PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration
# NOTE: If your password contains special characters like #, $, quotes, or spaces, ALWAYS wrap it in double quotes!
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=creativegini
POSTGRES_USER=postgres
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_SSL=false
# Optional full connection URI (e.g. for cloud providers like Neon, AWS RDS, Supabase)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/creativegini

# Authentication & JWT
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend Origins (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://creativegini.com,https://www.creativegini.com

# Email / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=team@creativegini.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM="CreativeGini <team@creativegini.com>"
PORTAL_BASE_URL=http://localhost:5173

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=creativegini-assets
